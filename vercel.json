{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "installCommand": "npm install",
  "functions": {
    "api/wa-webhook.js": {
      "maxDuration": 300
    },
    "api/wa-admin.js": {
      "maxDuration": 60
    },
    "api/morning-catchup.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/factory-check?step=ask",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/factory-check?step=alert",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/morning-catchup",
      "schedule": "0 3 * * *"
    }
  ]
}